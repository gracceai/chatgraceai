# Copy this file to .env and adjust as needed.

# Port for the API server (the React app proxies /api to it).
PORT=3001

# Ollama Cloud
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=gpt-oss:120b

# Optional: comma-separated Ollama Cloud keys imported into the database on startup.
# Prefer `npm run keys:add` so keys never sit in a plain-text file.
OLLAMA_API_KEYS=

# Seconds a key rests after Ollama returns 429 without a Retry-After header.
KEY_COOLDOWN_SECONDS=60

# Where the SQLite database lives (relative to the server folder).
DB_PATH=data/grace.db

# Crisis contacts Grace shares when someone may be in danger.
# Confirm the correct Namibian helpline numbers before going live.
CRISIS_CONTACTS=your local emergency services or the nearest hospital
